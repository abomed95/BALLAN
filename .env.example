# ============================================================
# BALLAN — reglages de production. Copier en .env et remplir.
# Ne JAMAIS commiter le fichier .env.
# Generer un secret : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

BALLAN_MODE=production

# Nom de domaine public (HTTPS automatique), ex. ballan.exemple.dj
BALLAN_DOMAINE=

# Mot de passe PostgreSQL : lettres, chiffres, - et _ seulement.
POSTGRES_PASSWORD=

# Identifiant affiche par `ballan importer` (uuid de l'etablissement).
BALLAN_ETABLISSEMENT_ID=

# Mot de passe de la page /secretariat (utilisateur : secretariat)
# et jeton de l'API /admin. 24 caracteres minimum.
BALLAN_ADMIN_TOKEN=

# Numero WhatsApp du secretariat, prevenu a chaque escalade (facultatif).
BALLAN_NUMERO_SECRETARIAT=

# --- WhatsApp Cloud API (Meta for Developers > votre application) ---
# Jeton d'acces PERMANENT d'un utilisateur systeme (pas le jeton temporaire de 24 h).
WHATSAPP_TOKEN=
# « Phone number ID » du numero de l'ecole (pas le numero lui-meme).
WHATSAPP_PHONE_NUMBER_ID=
# « App secret » (Parametres de l'application > Base) : signe les webhooks.
WHATSAPP_APP_SECRET=
# Jeton choisi par vous, recopie dans la configuration du webhook chez Meta. 24 car. min.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Nom du modele de message approuve pour les rappels (3 variables : prenom, date, avec qui).
WHATSAPP_TEMPLATE_RAPPEL=

# Langues non relues par un locuteur natif : refusees en production sauf
# pilote explicitement encadre (voir core/i18n/locales/RELECTURE.md).
BALLAN_AUTORISER_LANGUES_NON_RELUES=0

BALLAN_NIVEAU_JOURNAL=INFO
